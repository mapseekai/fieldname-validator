{
  "name": "fieldname-validator",
  "version": "0.3.0",
  "description": "Validate one field name against selected database and geospatial format rules.",
  "license": "UNLICENSED",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "README.zh-CN.md",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": "^18.18.0 || ^20.9.0 || >=22.0.0"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "lint": "eslint src test",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "check:engines": "node scripts/verify-lock-engines.mjs",
    "prepack": "npm run build",
    "test:package": "node scripts/verify-package.mjs",
    "check": "npm run check:engines && npm run lint && npm run typecheck && npm test && npm run test:package"
  },
  "dependencies": {},
  "overrides": {
    "vite": "6.4.3",
    "tsup": {
      "esbuild": "0.28.1"
    }
  },
  "devDependencies": {
    "@eslint/js": "9.39.3",
    "@types/node": "^18.0.0",
    "esbuild": "0.28.1",
    "eslint": "9.39.3",
    "semver": "7.7.3",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "8.55.0",
    "vitest": "^3.0.0"
  }
}
